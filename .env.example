# LiteLLM Configuration
# Copy this file to .env and update with your actual values

# API key generated from your LiteLLM GUI
# Generate this in your LiteLLM interface under API Keys
API_KEY=your-litellm-generated-key-here

# Base URL of your LiteLLM instance
# IMPORTANT: Use host.docker.internal (not localhost) when running in Docker!
# - Docker: http://host.docker.internal:4000/v1 (reaches host machine)
# - Local dev: http://localhost:4000/v1 (only works outside Docker)
BASE_URL=http://host.docker.internal:4000/v1

# Model refresh interval in milliseconds (optional)
# How often to fetch updated models from LiteLLM
# Default: 300000 (5 minutes)
MODEL_REFRESH_INTERVAL=300000

# Connection ping interval in milliseconds (optional)
# How often to send keep-alive pings during streaming
# Default: 10000 (10 seconds)
PING_INTERVAL=10000